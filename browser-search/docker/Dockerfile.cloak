# CloakBrowser — stealth Chromium exposing CDP on :9222.
# Hermes/agents connect via CDP (http://<host>:9222); the cloakbrowser CLI
# scripts in browser-search/scripts/cloak run against this endpoint.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        chromium \
        ca-certificates \
        fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

ENV CLOAK_HEADLESS=true
ENV HOME=/tmp

EXPOSE 9222

CMD ["chromium", "--headless", "--no-sandbox", "--disable-gpu", \
     "--disable-dev-shm-usage", "--remote-debugging-address=0.0.0.0", \
     "--remote-debugging-port=9222", "--user-data-dir=/tmp/cloak-profile"]
